+        (navigationItem.subtitle.length == 0 && navigationItem.largeSubtitle.length == 0 &&
+         navigationItem.largeSubtitleView == nil)) {
+      return;
+    }
+    UIScrollView *scrollView = [RNSScrollViewFinder findScrollViewInFirstDescendantChainFrom:self.view];
+    if (scrollView == nil) {
+      return;
+    }
