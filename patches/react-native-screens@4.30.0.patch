+// PATCH(dainorelis): collect the views that occupy horizontal space in the navigation bar's
+// content view (bar button items, custom left/right header subviews), skipping the title
+// subview itself. Recursion is needed because on iOS 26 UIKit nests buttons inside group
+// wrapper views (see -rnscreens_ios26_findDescendantBackButtonWrapper in UINavigationBar+RNSUtility).
+static void RNSDainorelisCollectOccupyingViews(UIView *view,
+                                               UIView *_Nullable titleSubview,
+                                               Class _Nullable barButtonClass,
+                                               NSMutableArray<UIView *> *result)
+{
+  if (view.hidden || view.alpha < 0.01) {
+    return;
+  }
+  if (view == titleSubview) {
+    return;
+  }
+  if ([view isKindOfClass:[RNSScreenStackHeaderSubview class]]) {
+    // A custom left/right header item; count it as occupied space, don't descend into it.
+    [result addObject:view];
+    return;
+  }
+  if ((barButtonClass != nil && [view isKindOfClass:barButtonClass]) || [view isKindOfClass:[UIControl class]]) {
+    [result addObject:view];
+    return;
+  }
+  for (UIView *subview in view.subviews) {
+    RNSDainorelisCollectOccupyingViews(subview, titleSubview, barButtonClass, result);
+  }
+}
