+// PATCH(dainorelis): keep a large title expanded while its screen is pushed (iOS 26+).
+//
+// During a push UIKit first lays the bar out with an estimated large title height. It leaves out the subtitle
+// under the large title (`navigationItem.subtitle`, or the `largeSubtitleView` the header config patch sets), and
+// the marks that reach above the font's line height (the caron of Lithuanian š and ž). The scroll view is put at
+// the top for that estimate. When the real, taller title is measured, the content's offset no longer matches the
+// top; UIKit reads it as the content having been scrolled and collapses the title for the whole transition, and
+// the screen arrives with an inline title. Some titles whose height UIKit estimates right still arrive collapsed
+// on iOS 26.
+//
+// So once the estimate is applied, pull the content down past the top, as a pull-down gesture would: UIKit then
+// measures the full large title, and we put the content back at the top it measured. Both happen in layout passes
+// before the transition draws its first frame. Where the bar keeps its height, nothing comes to let go, so let go
+// on the next turn of the main queue too, after the current layout passes are done.
+- (void)dainorelis_keepLargeTitleExpandedDuringPush
+{
+#if RNS_IPHONE_OS_VERSION_AVAILABLE(26_0)
+  if (@available(iOS 26.0, *)) {
+    if (!_dainorelisKeepsLargeTitleExpanded) {
+      return;
+    }
+    if (self.navigationItem.largeTitleDisplayMode != UINavigationItemLargeTitleDisplayModeAlways) {
+      return;
+    }
+    UIScrollView *scrollView = [RNSScrollViewFinder findScrollViewInFirstDescendantChainFrom:self.view];
+    if (scrollView == nil) {
+      return;
+    }
+    const CGFloat barHeight = self.navigationController.navigationBar.frame.size.height;
+    const CGFloat top = -scrollView.adjustedContentInset.top;
+    if (_dainorelisPulledBarHeight == 0) {
+      // the scroll view sits at the top of the estimated bar
+      if (scrollView.adjustedContentInset.top > 0 && fabs(scrollView.contentOffset.y - top) < 0.5) {
+        _dainorelisPulledBarHeight = barHeight;
+        scrollView.contentOffset = CGPointMake(scrollView.contentOffset.x, top - self.view.bounds.size.height / 2);
+        __weak RNSScreen *weakSelf = self;
+        dispatch_async(dispatch_get_main_queue(), ^{
+          [weakSelf dainorelis_releasePulledContent];
+        });
+      }
+    } else if (fabs(barHeight - _dainorelisPulledBarHeight) > 0.5) {
+      // the bar has its measured height
+      [self dainorelis_releasePulledContent];
+    }
