+
+#if canImport(UIKit)
+// PATCH(dainorelis): SwiftUI has no offset-based scrolling for List, so this finds the UICollectionView behind it.
+// The finder sits in the list's background, a sibling of the collection view, so the search goes up from it and
+// takes the shallowest scroll view under each ancestor in turn: the list's own before any inside its rows.
+final class ListScrollController {
+  weak var anchorView: UIView?
+  private weak var cachedScrollView: UIScrollView?
+
+  func scrollView() -> UIScrollView? {
+    if let cachedScrollView, cachedScrollView.window != nil {
+      return cachedScrollView
+    }
+    var ancestor = anchorView?.superview
+    while let view = ancestor {
+      if let found = Self.shallowestScrollView(in: view) {
+        cachedScrollView = found
+        return found
+      }
+      ancestor = view.superview
+    }
+    return nil
+  }
+
+  func scrollToOffset(_ offset: CGFloat, animated: Bool) {
+    guard let scrollView = scrollView() else {
+      return
+    }
+    scrollView.layoutIfNeeded()
+    let inset = scrollView.adjustedContentInset
+    let minY = -inset.top
+    let maxY = max(minY, scrollView.contentSize.height - scrollView.bounds.height + inset.bottom)
+    let y = min(max(offset - inset.top, minY), maxY)
+    // stops a fling in progress, which would otherwise carry on from the new offset
+    scrollView.setContentOffset(scrollView.contentOffset, animated: false)
+    scrollView.setContentOffset(CGPoint(x: scrollView.contentOffset.x, y: y), animated: animated)
+  }
+
+  private static func shallowestScrollView(in root: UIView) -> UIScrollView? {
+    var queue: [UIView] = root.subviews
+    var index = 0
+    while index < queue.count {
+      let view = queue[index]
+      index += 1
+      if let collectionView = view as? UICollectionView {
+        return collectionView
+      }
+      queue.append(contentsOf: view.subviews)
+    }
+    return nil
+  }
+}
+
+private struct ListScrollViewFinder: UIViewRepresentable {
+  let controller: ListScrollController
+
+  func makeUIView(context: Context) -> UIView {
+    let view = UIView()
+    view.isUserInteractionEnabled = false
+    view.isHidden = true
+    controller.anchorView = view
+    return view
+  }
+
+  func updateUIView(_ uiView: UIView, context: Context) {
+    controller.anchorView = uiView
+  }
+}
+#else
+// PATCH(dainorelis): no UIKit, nothing to scroll
+final class ListScrollController {
+  func scrollToOffset(_ offset: CGFloat, animated: Bool) {}
+}
+#endif
