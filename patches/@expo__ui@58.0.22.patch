index 0000000000000000000000000000000000000000..23d2f3d58319ab24f025095a516b99735e8dc170
--- /dev/null
+++ b/ios/Modifiers/SectionIndexModifiers.swift
@@ -0,0 +1,51 @@
+// PATCH(dainorelis): iOS 26's native section index for List: a section's label in the index, and whether the
+// list shows the index. Below iOS 26 both are no-ops.
+
+import ExpoModulesCore
+import SwiftUI
+
+internal struct SectionIndexLabelModifier: ViewModifier, Record {
+  @Field var label: String = ""
+
+  func body(content: Content) -> some View {
+#if os(iOS)
+    if #available(iOS 26.0, *) {
+      content.sectionIndexLabel(Text(verbatim: label))
+    } else {
+      content
+    }
+#else
+    content
+#endif
+  }
+}
+
+internal enum SectionIndexVisibilityOptions: String, Enumerable {
+  case automatic
+  case visible
+  case hidden
+}
+
+internal struct ListSectionIndexVisibilityModifier: ViewModifier, Record {
+  @Field var visibility: SectionIndexVisibilityOptions = .automatic
+
+  func body(content: Content) -> some View {
+#if os(iOS)
+    if #available(iOS 26.0, *) {
+      content.listSectionIndexVisibility(resolved)
+    } else {
+      content
+    }
+#else
+    content
+#endif
+  }
+
+  private var resolved: Visibility {
+    switch visibility {
+    case .automatic: .automatic
+    case .visible: .visible
+    case .hidden: .hidden
+    }
+  }
+}
