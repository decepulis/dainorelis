diff --git a/index.js b/index.js
index 916faa503706e05ec05f5fda0ab4ce56adcd41b0..f99e2fe85a06b4e4c06e30ff1f304eef91804801 100644
--- a/index.js
+++ b/index.js
@@ -161,8 +161,10 @@ export default class Pdf extends Component {
     componentWillUnmount() {
         this._mounted = false;
         if (this.lastRNBFTask) {
-            // this.lastRNBFTask.cancel(err => {
-            // });
+            // dainorelis: cancel, so a remount (variant switch, Fast Refresh) doesn't race this download
+            try {
+                this.lastRNBFTask.cancel(() => {});
+            } catch (e) {}
             this.lastRNBFTask = null;
         }
 
@@ -275,7 +277,8 @@ export default class Pdf extends Component {
             this.lastRNBFTask = null;
         }
 
-        const tempCacheFile = cacheFile + '.tmp';
+        // dainorelis: one temp file per download, so two loads of the same URL can't delete each other's file
+        const tempCacheFile = cacheFile + '.' + Date.now() + Math.random().toString(36).slice(2) + '.tmp';
         // Await the unlink: a fire-and-forget call here lets ReactNativeBlobUtil's
         // open(path) race with the in-flight delete on Android 14 + New Architecture and
         // surface as `ENOENT (No such file or directory)` on the temp file. See #1018.
@@ -341,7 +344,7 @@ export default class Pdf extends Component {
         } catch (error) {
             this.lastRNBFTask = null;
             await this._unlinkFile(tempCacheFile);
-            await this._unlinkFile(cacheFile);
+            // dainorelis: keep cacheFile; it is only ever written after a verified download
             this._onError(error);
         }
 
diff --git a/ios/RNPDFPdf/RNPDFPdfView.mm b/ios/RNPDFPdf/RNPDFPdfView.mm
