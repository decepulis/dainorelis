# Supabase project — Project Settings → API Keys. The Supabase Vercel
# integration sets these for you. The legacy NEXT_PUBLIC_SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY names are still read as a fallback.
# The publishable key is safe in the browser; row level security is what gates access.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only. Bypasses row level security; used by /api/export, /api/health
# and the import scripts. Never expose this to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# Shared secret the app's build script presents to /api/export.
# Generate one with: openssl rand -hex 32
EXPORT_TOKEN=...

# Required in production: without it /api/health answers 503, and the daily
# keep-alive cron stops keeping Supabase awake. Vercel's cron authenticates with
# it, closing /api/health to everyone else. Generate with: openssl rand -hex 32
CRON_SECRET=...

# Only needed for pnpm generate-metadata.
OPENAI_API_KEY=...
