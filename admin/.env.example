# Supabase project — Project Settings → API.
# The anon key is safe in the browser; row level security is what gates access.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=...

# Server only. Bypasses row level security; used by /api/export, /api/health
# and the import scripts. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=...

# Shared secret the app's build script presents to /api/export.
# Generate one with: openssl rand -hex 32
EXPORT_TOKEN=...

# Optional. Set it and Vercel's daily keep-alive cron authenticates with it,
# closing /api/health to everyone else. Generate with: openssl rand -hex 32
CRON_SECRET=...

# Only needed to run the one-time Airtable migration (pnpm import:airtable).
AIRTABLE_TOKEN=...

# Only needed for pnpm generate-metadata.
OPENAI_API_KEY=...
