{
  "name": "dainorelis",
  "main": "expo-router/entry",
  "version": "3.0.0",
  "scripts": {
    "update-songs": "tsx ./scripts/update-songs.ts && pnpm run generate-indices",
    "generate-indices": "tsx ./scripts/generate-search-indices.ts",
    "generate-metadata": "pnpm --filter @dainorelis/admin generate-metadata",
    "generate-metadata:test": "pnpm --filter @dainorelis/admin generate-metadata -- --limit 5",
    "dev": "expo start",
    "dev:android": "expo run:android",
    "dev:ios": "expo run:ios",
    "dev:web": "expo start --web",
    "build:web:disabled": "expo export --platform web",
    "build:web": "echo \"Building site not yet enabled\"",
    "test": "echo \"No tests specified\" && exit 0",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "admin": "pnpm --filter @dainorelis/admin dev"
  },
  "dependencies": {
    "@expo/material-symbols": "^0.1.1",
    "@expo/metro-runtime": "~58.0.14",
    "@expo/ui": "~58.0.18",
    "@react-native-vector-icons/fontawesome6": "^13.1.1",
    "expo": "~58.0.11",
    "expo-asset": "~58.0.16",
    "expo-audio": "~58.0.9",
    "expo-blur": "~58.0.3",
    "expo-build-properties": "~58.0.10",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.8",
    "expo-glass-effect": "~58.0.3",
    "expo-haptics": "~58.0.6",
    "expo-image": "~58.0.15",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.20",
    "expo-splash-screen": "~58.0.9",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "fuse.js": "^7.1.0",
    "i18next": "^25.7.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^16.5.0",
    "react-native": "0.88.0",
    "react-native-blob-util": "^0.24.5",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-markdown-display": "^7.0.2",
    "react-native-mmkv": "^4.1.2",
    "react-native-nitro-modules": "^0.34.1",
    "react-native-pdf": "^7.0.3",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.3.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unused-imports": "^4.3.0",
    "prettier": "^3.7.4",
    "remove-markdown": "^0.6.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "pnpm": {
    "patchedDependencies": {
      "react-native-screens@4.30.0": "patches/react-native-screens@4.30.0.patch"
    }
  },
  "private": true
}
