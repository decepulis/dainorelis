{
  "name": "dainorelis",
  "main": "expo-router/entry",
  "version": "3.0.0",
  "scripts": {
    "update-songs": "ts-node --project tsconfig.scripts.json ./scripts/update-songs.ts; pnpm run generate-indices",
    "generate-indices": "ts-node --project tsconfig.scripts.json ./scripts/generate-search-indices.ts",
    "generate-metadata": "ts-node --project tsconfig.scripts.json ./scripts/generate-song-metadata.ts",
    "generate-metadata:test": "ts-node --project tsconfig.scripts.json ./scripts/generate-song-metadata.ts --limit=5",
    "dev": "expo start",
    "dev:android": "expo run:android",
    "dev:ios": "expo run:ios",
    "dev:web": "expo start --web",
    "build:web:disabled": "expo export --platform web",
    "build:web": "echo \"Building site not yet enabled\"",
    "test": "echo \"No tests specified\" && exit 0",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "format": "prettier --write .",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
